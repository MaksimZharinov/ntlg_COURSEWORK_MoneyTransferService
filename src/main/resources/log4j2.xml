<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property resource="application.properties"/>

    <appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
        <encoder>
            <pattern>${logging.pattern.console}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="org.apache.log4j.rolling.RollingFileAppender">
        <file>${logging.file.name}</file>
        <rollingPolicy class="org.apache.log4j.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logging.file.name}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>${logging.max.history}</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="org.apache.log4j.rolling.SizeBasedTriggeringPolicy">
                <maxFileSize>${logging.max.size}</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${logging.pattern.file}</pattern>
        </encoder>
    </appender>

    <!-- Уровень логирования -->
    <root level="${logging.level.root}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>